{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionPlan",
  "type": "object",
  "required": [
    "plan_id",
    "therapeutic_targets",
    "safety_constraints",
    "music_objectives"
  ],
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "therapeutic_targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "session_objectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safety_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "music_objectives": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "integration_prompts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_review_required": {
      "type": "boolean"
    }
  }
}