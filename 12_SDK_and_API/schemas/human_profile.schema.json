{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HumanProfile",
  "type": "object",
  "required": [
    "profile_id",
    "declared_problem",
    "hypotheses",
    "risk_flags",
    "readiness",
    "recommended_next_step"
  ],
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "declared_problem": {
      "type": "string"
    },
    "confirmed_targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_for": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_against": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "readiness": {
      "type": "object",
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "sensor_context": {
      "type": "object"
    },
    "recommended_next_step": {
      "type": "string"
    },
    "human_review_required": {
      "type": "boolean"
    }
  }
}